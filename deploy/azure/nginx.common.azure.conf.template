# Shared server-context config for both the plain-HTTP (nginx.conf) and
# TLS-terminated (nginx.ssl.conf) variants. Kept in one file so the two never
# drift — see DEPLOYMENT_TLS.md for when to use which.

# Security headers
add_header X-Content-Type-Options nosniff always;
add_header X-Frame-Options SAMEORIGIN always;
add_header Referrer-Policy strict-origin-when-cross-origin always;

# Content-Security-Policy. script-src/style-src stay same-origin-ish because
# Angular's production build has no inline <script>, but Angular/CDK inject
# <style> tags at runtime hence 'unsafe-inline' on style-src. connect-src and
# img-src are widened to https: because: (1) the AI agent's Ollama endpoint is
# a user-supplied URL (Settings), and (2) drawing thumbnails/uploads are
# fetched from whatever S3/R2/MinIO endpoint S3_PUBLIC_ENDPOINT points at.
#
# ACTION NEEDED if you configure a custom Clerk domain: script-src/frame-src
# below only allow Clerk's default `*.clerk.accounts.dev` host (what every
# Clerk instance gets out of the box) plus `*.clerk.com`/`clerk.com`. Clerk's
# Frontend API host is derived at runtime from the publishable key
# (clerk-ui-loader.ts) — if your production instance uses a custom domain
# (e.g. a CNAME like accounts.yourapp.com), CSP will silently block the
# `@clerk/ui` script and sign-in will not load. Add that exact host to both
# script-src and frame-src below before going live with a custom domain.
add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' https://*.clerk.accounts.dev https://*.clerk.com https://clerk.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; worker-src 'self' blob:; frame-src https://*.clerk.accounts.dev https://*.clerk.com https://clerk.com" always;

gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml font/woff2;

location = /healthz { return 200 'ok'; add_header Content-Type text/plain; }

# Disallow crawling of the API surface; the app shell itself is fine to index.
location = /robots.txt { try_files $uri =404; }
location = /sitemap.xml { try_files $uri =404; }

# CADO API. The app calls a relative `/api/v1/...` in production, so
# this proxy is what makes that URL exist - without it the request falls into
# the SPA fallback and gets index.html back. `^~` stops the hashed-asset regex
# below from ever capturing an API path such as /api/v1/drawings/x.dxf.
# ${API_ORIGIN} is substituted at container start by deploy/azure/docker-entrypoint.sh
# with the API Container App's internal FQDN.
location ^~ /api/ {
  # Container Apps FQDNs resolve via public DNS and can change IP, so nginx must
  # re-resolve rather than caching the boot-time answer. 168.63.129.16 is Azure's
  # platform DNS, reachable from inside every Container App.
  resolver 168.63.129.16 valid=30s ipv6=off;
  set $api_origin ${API_ORIGIN};
  set $api_host   ${API_HOST};
  proxy_pass $api_origin;

  proxy_http_version 1.1;
  # Container Apps ingress routes by Host: it must be the API app's own FQDN, or
  # ingress cannot tell which app the request is for and answers its own 404
  # ("This Container App is stopped or does not exist"). $proxy_host is not
  # usable here — with a variable in proxy_pass it does not resolve to the
  # upstream name — so the host is passed in explicitly alongside the origin.
  # The same name is the TLS SNI, which the upstream certificate is issued for.
  proxy_ssl_server_name on;
  proxy_ssl_name    $api_host;
  proxy_set_header  Host             $api_host;
  proxy_set_header X-Forwarded-Host  $host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  # NOT $scheme: Container Apps ingress terminates TLS and forwards plain HTTP,
  # so $scheme is always "http" here. Trust ingress's own header instead.
  proxy_set_header X-Forwarded-Proto $forwarded_proto;
  proxy_request_buffering off;   # stream multi-MB text/plain drawing saves
  proxy_read_timeout      120s;
  client_max_body_size    8m;    # 5 MB inline DXF + headroom; nginx's 1 MB default would 413 every save
  add_header Cache-Control "no-store" always;
}

# Hashed build artefacts are immutable
location ~* \.(?:js|css|woff2?|png|ico|svg)$ {
  expires 1y;
  add_header Cache-Control "public, immutable";
  try_files $uri =404;
}

# Never cache the app shell so new releases are picked up immediately
location = /index.html {
  add_header Cache-Control "no-cache, no-store, must-revalidate";
}

# SPA fallback
location / {
  try_files $uri $uri/ /index.html;
}
