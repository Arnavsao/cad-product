{
  "name": "aagento-cad",
  "version": "1.0.0",
  "description": "Aagento CAD — standalone browser-based 2D CAD editor (DXF import/export, layouts, blocks, dimensions, AI drafting assistant).",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:lan": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "analyze": "ng build --configuration production --stats-json",
    "docker:build": "docker build -t aagento-cad .",
    "docker:run": "docker run --rm -p 8080:80 aagento-cad",
    "setup": "npm install && npm --prefix server install && npm run db:up && npm run db:migrate",
    "dev": "npm run db:up && concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix server run start:dev",
    "dev:web": "ng serve",
    "db:up": "docker compose up -d --wait postgres minio && docker compose run --rm minio-init",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && npm run db:up && npm run db:migrate",
    "db:migrate": "npm --prefix server run prisma:migrate",
    "db:seed": "npm --prefix server run db:seed",
    "db:studio": "npm --prefix server run prisma:studio"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 120,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.1.0",
    "@angular/compiler": "^20.1.0",
    "@angular/core": "^20.1.0",
    "@angular/forms": "^20.1.0",
    "@angular/platform-browser": "^20.1.0",
    "@angular/router": "^20.1.0",
    "@sentry/browser": "^10.72.0",
    "@supabase/supabase-js": "^2.113.0",
    "clipper-lib": "^6.4.2",
    "dxf-parser": "^1.1.2",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.1.5",
    "@angular/cli": "^20.1.5",
    "@angular/compiler-cli": "^20.1.0",
    "@types/clipper-lib": "^6.4.0",
    "@types/jasmine": "~5.1.0",
    "concurrently": "^10.0.5",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.2"
  }
}
