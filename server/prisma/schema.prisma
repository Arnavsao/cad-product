// CADO data model — Postgres holds metadata only; DXF payloads and
// thumbnails live in S3-compatible object storage under the keys in
// `src/storage/storage-keys.ts`.
//
// Prisma 7: the datasource URL lives in `prisma.config.ts` (CLI/migrations use
// DIRECT_DATABASE_URL) and the runtime client is constructed with a driver
// adapter on DATABASE_URL (see `src/prisma/prisma.service.ts`).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums — stored lowercase so raw SQL / psql output matches the wire format.
// ---------------------------------------------------------------------------

enum Units {
  MM @map("mm")
  CM @map("cm")
  M  @map("m")
  IN @map("in")
  FT @map("ft")

  @@map("units")
}

enum UserRole {
  ARCHITECT @map("architect")
  ENGINEER  @map("engineer")
  STUDENT   @map("student")
  OTHER     @map("other")

  @@map("user_role")
}

enum DrawingFormat {
  DXF @map("dxf")
  DWG @map("dwg")

  @@map("drawing_format")
}

enum SharePermission {
  VIEW @map("view")
  EDIT @map("edit")

  @@map("share_permission")
}

enum FeedbackKind {
  BUG      @map("bug")
  IDEA     @map("idea")
  QUESTION @map("question")
  OTHER    @map("other")

  @@map("feedback_kind")
}

enum NotificationKind {
  SYSTEM  @map("system")
  DRAWING @map("drawing")
  STORAGE @map("storage")
  ACCOUNT @map("account")

  @@map("notification_kind")
}

// Ordered least- to most-privileged; `OrganizationsService.requireMembership`
// compares by the `RANK` table there, so any new role must be inserted at the
// right position *and* given a rank.
//
// `VIEWER` is the read-only tier: a viewer opens and downloads org drawings but
// never saves, renames or trashes them. It is first so the Postgres enum sort
// order still matches privilege (the members list orders by `role desc`).
enum OrgRole {
  VIEWER @map("viewer")
  MEMBER @map("member")
  ADMIN  @map("admin")
  OWNER  @map("owner")

  @@map("org_role")
}

/// Plan a user is entitled to. Mirrors the tiers on the pricing page.
/// FREE is the implicit default, so an account with no subscription row still
/// has a plan without any backfill.
enum BillingPlan {
  FREE @map("free")
  PRO  @map("pro")
  TEAM @map("team")

  @@map("billing_plan")
}

/// Lifecycle of a Dodo Payments subscription, narrowed to what we act on.
///
/// Deliberately NOT a mirror of Dodo's own status vocabulary: their set is
/// wider and can grow, and an unrecognised value arriving on a webhook must not
/// break the mapper. `subscriptions.mapStatus` folds anything unknown into
/// `INCOMPLETE`, which is the safe direction — no access granted.
enum SubscriptionStatus {
  /// Paid and current. The only status that grants a paid plan.
  ACTIVE    @map("active")
  /// In a trial that has not converted yet. Grants the paid plan.
  TRIALING  @map("trialing")
  /// Payment failed and Dodo is retrying (dunning). Access is retained on
  /// purpose: revoking mid-retry punishes someone whose card merely expired.
  PAST_DUE  @map("past_due")
  /// Ended, either by the customer or by exhausted retries. No paid access.
  CANCELLED @map("cancelled")
  /// Created but never paid, or an unrecognised upstream status.
  INCOMPLETE @map("incomplete")

  @@map("subscription_status")
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id          String    @id @default(cuid())
  authId      String    @unique @map("auth_id")
  email       String
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  imageUrl    String?   @map("image_url")
  onboardedAt DateTime? @map("onboarded_at")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  preferences   UserPreferences?
  folders       Folder[]
  drawings      Drawing[]
  shareLinks    ShareLink[]
  sharesCreated Share[]         @relation("ShareCreator")
  feedback      Feedback[]
  notifications Notification[]
  memberships   OrgMembership[]
  orgsCreated   Organization[]  @relation("OrgCreator")
  invitesSent   OrgInvite[]     @relation("OrgInviteCreator")
  subscription  Subscription?

  @@index([email])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Organizations — a shared workspace. Drawings and folders carry a nullable
// `organizationId`: NULL is the owner's personal workspace, set means every
// member of that org can see and edit the row.
//
// `ownerId` on those rows keeps meaning "who created it" and never changes: it
// still roots the object-storage prefix (`users/{ownerId}/...`, see
// `src/storage/storage-keys.ts`), so moving a drawing into an org needs no
// object copying.
// ---------------------------------------------------------------------------

model Organization {
  id          String   @id @default(cuid())
  name        String
  // URL-safe handle, derived from `name` and deduped on create.
  slug        String   @unique
  // Short human-typeable code behind `POST /organizations/join`. Rotatable, so
  // leaking it is recoverable without disturbing existing members.
  joinCode    String   @unique @map("join_code")
  imageUrl    String?  @map("image_url")
  createdById String   @map("created_by_id")
  createdBy   User     @relation("OrgCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships OrgMembership[]
  invites     OrgInvite[]
  folders     Folder[]
  drawings    Drawing[]
  // Shares pointing AT this org: someone else's drawing or folder made visible
  // to every member of it (see the `Share` model).
  sharesReceived Share[] @relation("ShareTargetOrg")

  @@map("organizations")
}

model OrgMembership {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(MEMBER)
  joinedAt       DateTime     @default(now()) @map("joined_at")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("org_memberships")
}

// An outstanding invitation. `email` is stored lowercased so the accept path can
// match it against the caller's token claim exactly.
model OrgInvite {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           OrgRole      @default(MEMBER)
  token          String       @unique
  expiresAt      DateTime     @map("expires_at")
  acceptedAt     DateTime?    @map("accepted_at")
  createdById    String       @map("created_by_id")
  createdBy      User         @relation("OrgInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@map("org_invites")
}

model UserPreferences {
  userId              String    @id @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  units               Units     @default(MM)
  theme               String    @default("dark")
  // BCP 47 UI language tag, e.g. "en", "pt-BR", "zh-Hans". Free-form String
  // rather than an enum for the same reason `theme` is: the set of shipped
  // languages is a frontend concern, and adding one must not need a migration.
  // Validated against LOCALES on the way in (UpdatePreferencesDto).
  locale              String    @default("en")
  role                UserRole?
  defaultTemplate     String    @default("blank") @map("default_template")
  autosaveIntervalSec Int       @default(30) @map("autosave_interval_sec")
  uiState             Json?     @map("ui_state")

  // Email opt-outs. Two typed booleans rather than one JSON blob: they are read
  // on the send path (MailService.wants), where a column is both cheaper than
  // parsing JSON and impossible to typo. Default true — a user who never opened
  // Settings should still hear that something was shared with them.
  // Organization INVITATIONS are deliberately not gated by either; see
  // MailService's JSDoc for why.
  emailOnShare        Boolean   @default(true) @map("email_on_share")
  emailOnOrgActivity  Boolean   @default(true) @map("email_on_org_activity")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("user_preferences")
}

// ---------------------------------------------------------------------------
// Folders — adjacency-list tree. Root-level name uniqueness (parentId IS NULL)
// is enforced in FoldersService because SQL treats NULLs as distinct.
//
// `organizationId` NULL = the owner's personal tree; set = the org's shared
// tree. The two never mix: a personal folder cannot be moved under an org one.
// ---------------------------------------------------------------------------

model Folder {
  id             String        @id @default(cuid())
  ownerId        String        @map("owner_id")
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentId       String?       @map("parent_id")
  parent         Folder?       @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       Folder[]      @relation("FolderTree")
  name           String
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  drawings Drawing[]
  shares   Share[]

  // Sibling-name uniqueness is two partial expression indexes created by hand in
  // the `organizations_and_drawing_names` migration, not `@@unique` here: the
  // key differs per workspace (owner vs organization) and `COALESCE(parent_id,
  // '')` is needed because SQL treats every NULL parent as distinct. Prisma
  // cannot express either, so `prisma db pull` will not round-trip them.
  @@index([ownerId, parentId])
  @@index([organizationId, parentId])
  @@map("folders")
}

// ---------------------------------------------------------------------------
// Drawings — one row per document; `storageKey` always points at the object
// for `currentVersion`. Trash = `deletedAt` set; permanent delete removes the
// row (cascading versions/share links) and the storage prefix.
//
// `ownerId` is the creator and roots the storage prefix for every version, even
// when the drawing lives in an organization; `organizationId` is what decides
// who may read and write it.
// ---------------------------------------------------------------------------

model Drawing {
  id             String        @id @default(cuid())
  ownerId        String        @map("owner_id")
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folderId       String?       @map("folder_id")
  folder         Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name           String
  format         DrawingFormat @default(DXF)
  storageKey     String        @map("storage_key")
  byteSize       Int           @map("byte_size")
  thumbnailKey   String?       @map("thumbnail_key")
  currentVersion Int           @default(1) @map("current_version")
  lastOpenedAt   DateTime?     @map("last_opened_at")
  deletedAt      DateTime?     @map("deleted_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  versions   DrawingVersion[]
  shareLinks ShareLink[]
  shares     Share[]

  // Name uniqueness per workspace+folder is enforced by two partial expression
  // indexes in the `organizations_and_drawing_names` migration (see the note on
  // `Folder`). Trashed rows are excluded, so binning a drawing frees its name.
  @@index([ownerId, updatedAt(sort: Desc)])
  @@index([ownerId, lastOpenedAt(sort: Desc)])
  @@index([ownerId, folderId])
  @@index([ownerId, deletedAt])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@index([organizationId, lastOpenedAt(sort: Desc)])
  @@index([organizationId, deletedAt])
  @@map("drawings")
}

// `@@unique([drawingId, version])` is the save lock: two concurrent saves that
// both compute `next = currentVersion + 1` cannot both insert.
model DrawingVersion {
  id         String   @id @default(cuid())
  drawingId  String   @map("drawing_id")
  drawing    Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  version    Int
  storageKey String   @map("storage_key")
  byteSize   Int      @map("byte_size")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([drawingId, version])
  @@map("drawing_versions")
}

// ---------------------------------------------------------------------------
// Sharing
// ---------------------------------------------------------------------------

// A durable grant on one drawing OR one folder, to one person (by email) OR to
// one whole organization.
//
// Design decisions:
//
// - **The target is an email, not a user id.** A share can be created for
//   someone who has not signed up yet; access time matches the lowercased
//   address against `users.email`, so the grant starts working the moment they
//   sign in. A user-id column would have forced "invite first, share later".
//
// - **A folder share covers the whole subtree.** `common/access.ts` walks a
//   drawing's ancestor folders (depth-bounded) and takes the highest live
//   share it finds, so sharing a folder shares everything inside it, including
//   things added afterwards.
//
// - **Shares survive a move.** They name the resource, not the workspace: a
//   drawing moved from personal into an org keeps the people it was shared
//   with, which is what someone who shared it expects.
//
// - **The two "exactly one of" rules are CHECK constraints**, and the four
//   partial unique indexes are what make `PUT …/shares` an upsert (Prisma
//   cannot express either — see the migration).
model Share {
  id                   String          @id @default(cuid())
  drawingId            String?         @map("drawing_id")
  drawing              Drawing?        @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  folderId             String?         @map("folder_id")
  folder               Folder?         @relation(fields: [folderId], references: [id], onDelete: Cascade)
  // Exactly one target. Email is lowercased and matched against `users.email`
  // at access time, so a share can be created for someone who has not signed
  // up yet.
  targetEmail          String?         @map("target_email")
  targetOrganizationId String?         @map("target_organization_id")
  targetOrganization   Organization?   @relation("ShareTargetOrg", fields: [targetOrganizationId], references: [id], onDelete: Cascade)
  permission           SharePermission @default(VIEW)
  createdById          String          @map("created_by_id")
  createdBy            User            @relation("ShareCreator", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt            DateTime?       @map("expires_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  @@index([drawingId])
  @@index([folderId])
  @@index([targetEmail])
  @@index([targetOrganizationId])
  @@map("shares")
}

// An unauthenticated-recipient link to one drawing. `GET /shared/:token` reads
// it; accepting one converts it into a durable `Share` for that person, so the
// drawing then appears under "Shared with me" without the link.
model ShareLink {
  id          String          @id @default(cuid())
  drawingId   String          @map("drawing_id")
  drawing     Drawing         @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  createdById String          @map("created_by_id")
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  token       String          @unique
  permission  SharePermission @default(VIEW)
  expiresAt   DateTime?       @map("expires_at")
  revokedAt   DateTime?       @map("revoked_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([drawingId])
  // The share dialog only ever lists a drawing's *live* links.
  @@index([drawingId, revokedAt])
  @@map("share_links")
}


// ---------------------------------------------------------------------------
// Feedback / notifications
// ---------------------------------------------------------------------------

// `POST /feedback` is public, so `userId` is nullable: a signed-out visitor can
// still report a bug, and `email` is then the only way to reply. `SetNull` (not
// `Cascade`) on purpose — deleting an account must stop identifying the feedback
// it left without destroying the report itself.
model Feedback {
  id        String       @id @default(cuid())
  userId    String?      @map("user_id")
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      FeedbackKind @default(OTHER)
  rating    Int?
  message   String
  email     String?
  // { route, appVersion, userAgent } — captured client-side to make a report reproducible.
  context   Json?
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("feedback")
}

// In-app inbox. `readAt` is a nullable timestamp rather than a boolean so "when
// did they see it" survives, and the unread index stays cheap.
model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind @default(SYSTEM)
  title     String
  body      String?
  linkUrl   String?          @map("link_url")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Billing (Dodo Payments)
// ---------------------------------------------------------------------------

/// The user's current subscription, as last reported by Dodo Payments.
///
/// This table is a **projection of Dodo's state, not the source of truth.**
/// Every field is written from a webhook or from an explicit reconcile against
/// their API; nothing here is authoritative on its own. That is why there is no
/// local "cancel" flag to keep in step — a cancellation is Dodo's event, and we
/// learn about it the same way we learn about everything else.
///
/// One row per user (`userId` is the primary key) because the pricing page sells
/// one plan at a time. A future add-on or seat model would become its own table
/// rather than a second row here.
model Subscription {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Dodo's customer id (`cus_…`). Survives the subscription: it is what the
  /// customer-portal link and any future purchase is created against, so it is
  /// kept even after a cancellation.
  dodoCustomerId String  @map("dodo_customer_id")
  /// Dodo's subscription id (`sub_…`). Null between signing up for a customer
  /// record and completing a first checkout.
  dodoSubscriptionId String? @unique @map("dodo_subscription_id")
  /// The product id that was bought, so a plan change is traceable to a price.
  dodoProductId      String? @map("dodo_product_id")

  plan   BillingPlan        @default(FREE)
  status SubscriptionStatus @default(INCOMPLETE)

  /// End of the paid period. Access to a paid plan is granted while `status`
  /// allows it; this is what the UI shows as "renews on" / "access until".
  currentPeriodEnd DateTime? @map("current_period_end")
  /// Set when the customer has asked to cancel but the period has not lapsed.
  /// They keep access until `currentPeriodEnd`, which is what they paid for.
  cancelAtPeriodEnd Boolean @default(false) @map("cancel_at_period_end")
  /// When a trial ends. Null when the subscription never had one.
  trialEndsAt DateTime? @map("trial_ends_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([dodoCustomerId])
  @@map("subscriptions")
}

/// Every webhook Dodo has delivered, keyed by their event id.
///
/// Exists for **idempotency**, which is not optional here: Dodo retries a failed
/// delivery up to 8 times with backoff, and a retry of an already-applied event
/// must not be applied twice. The handler inserts the id first and treats a
/// unique-constraint violation as "already seen, ack and stop".
///
/// It doubles as an audit trail. When a customer disputes what their plan was on
/// a given day, this is the record of what we were told and when.
model WebhookEvent {
  /// Dodo's `webhook-id` header. Primary key so the insert IS the dedupe.
  id String @id

  /// Event name, e.g. `subscription.active`. Not an enum: Dodo documents 47
  /// types and adds more, and an unknown one must still be recorded.
  type String
  /// The verified payload, kept whole for replay and for answering "what did
  /// they actually send us".
  payload Json
  /// Null until handled. A row with a null `processedAt` and a `error` is a
  /// delivery worth investigating.
  processedAt DateTime? @map("processed_at")
  /// Message from the last failed attempt, for triage.
  error String?

  receivedAt DateTime @default(now()) @map("received_at")

  @@index([type, receivedAt])
  @@index([processedAt])
  @@map("webhook_events")
}
