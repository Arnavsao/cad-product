# ---------------------------------------------------------------------------
# CADOnline API — environment. Copy to `.env` for local development.
# Validated at boot by src/config/env.schema.ts (Zod); the process refuses to
# start on a bad value rather than failing later on a request.
# ---------------------------------------------------------------------------

# --- HTTP -------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:4200
# pino level: trace|debug|info|warn|error|fatal|silent
LOG_LEVEL=debug

# --- Postgres ---------------------------------------------------------------
# Runtime (pooled in prod — Neon "-pooler" host). Local: docker-compose postgres.
DATABASE_URL=postgresql://cad:cad@localhost:5432/cad
# Migrations / Prisma CLI (direct, non-pooled). Same as DATABASE_URL locally.
DIRECT_DATABASE_URL=postgresql://cad:cad@localhost:5432/cad

# --- Supabase auth ----------------------------------------------------------
# Project URL (https://<ref>.supabase.co). Required to verify access tokens: it
# is both the expected `iss` (<url>/auth/v1) and where the JWKS is fetched from.
# Without it the API answers 503 AUTH_NOT_CONFIGURED on authenticated routes.
SUPABASE_URL=
# Legacy symmetric JWT secret (Dashboard -> Settings -> API -> JWT Secret).
# When set, tokens are verified HS256 with it. Leave EMPTY on projects using
# asymmetric signing keys, where the JWKS under SUPABASE_URL is used instead.
# For local dev without a project, `npm run mint-token -- --write-env` fills
# this in with a test value and prints a matching token.
SUPABASE_JWT_SECRET=

# --- Object storage (S3 / MinIO / R2) ---------------------------------------
# Endpoint the API talks to. Local: docker-compose MinIO.
S3_ENDPOINT=http://localhost:9000
# Endpoint embedded in presigned URLs handed to browsers. Leave empty when it is
# the same as S3_ENDPOINT; set it when the API runs in a container and reaches
# MinIO as http://minio:9000 while browsers use http://localhost:9000.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=drawings
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# true for MinIO (bucket in path); false for AWS S3 / R2 virtual-hosted style.
S3_FORCE_PATH_STYLE=true

# --- Transactional email (Resend) -------------------------------------------
# All four are OPTIONAL. With RESEND_API_KEY or MAIL_FROM missing, the API logs
# every message it would have sent instead of sending it — which is the local
# development default, and is enough to see and check the exact text.
# API key from https://resend.com (Dashboard -> API Keys).
RESEND_API_KEY=
# Envelope From. The domain must be verified in Resend or sends are refused.
# e.g. MAIL_FROM=CADOnline <no-reply@cadonline.app>
MAIL_FROM=
# Optional Reply-To on every outbound message (e.g. support@cadonline.app).
MAIL_REPLY_TO=
# Public origin of the WEB app, used to build the links inside emails. Leave
# empty in development: it falls back to the first CORS_ORIGIN. Set it in
# production (e.g. https://cadonline.app) — the API cannot infer it, and a
# wrong value produces emails whose buttons go nowhere.
APP_BASE_URL=

# --- Limits -----------------------------------------------------------------
MAX_INLINE_CONTENT_BYTES=5242880
MAX_UPLOAD_BYTES=52428800
MAX_THUMBNAIL_BYTES=524288
MAX_VERSIONS_PER_DRAWING=50
DOWNLOAD_URL_TTL_SECONDS=600
THUMBNAIL_URL_TTL_SECONDS=7200
